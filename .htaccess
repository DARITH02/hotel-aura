<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent loop by not rewriting if the URI already contains /public/
    RewriteCond %{REQUEST_URI} !/public/
    
    # Handle assets and index.php routing
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Security: Disable Directory Browsing
Options -Indexes

# Protect sensitive directories
RewriteRule ^(app|config|database|routes|temp_junk)/ - [F,L]

# Protect sensitive files in the root
<FilesMatch "\.(log|env|json|md|sql)$">
    Order deny,allow
    Deny from all
</FilesMatch>
